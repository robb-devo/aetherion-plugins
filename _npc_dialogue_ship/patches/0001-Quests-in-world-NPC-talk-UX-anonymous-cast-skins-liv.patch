+            if (npc != null && LivingNpcService.isLiving(npc.getId())) {
+                Location at = living.locationOf(npc.getId());
+                if (at != null && at.getWorld() != null) {
+                    spots.put(npc.getId(), at);
+                }
+            }
+        }
+        if (spots.isEmpty()) {
+            return;
+        }
