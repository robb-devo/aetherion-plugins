+                }
+            }
+            if (audience.isEmpty()) {
+                continue;
+            }
+            String line = CastBook.idle(id);
+            if (line == null) {
+                continue;
+            }
+            npcIdleAt.put(id, socialTick);
+            for (Player p : audience) {
