+        final List<ChipView> chips = new ArrayList<>();
+        int hover = -1;
+        boolean hoverByScroll;
+        long chipsAt;
+        boolean questOffer;
+        Runnable onTimeout;
+        Location npcAt;
+        long lastPick = -1000;
+        long lastRefresh;
