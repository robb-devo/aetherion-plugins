+            Map.entry("dock_scaler", new double[][] {{266.5, 63, -365.5}, {272.5, 64, -361.5}, {260.5, 65, -365.5}}),
+            Map.entry("shanty_busker", new double[][] {{236.5, 64, -366.5}, {232.5, 64, -371.5}, {232.5, 64, -374.5}}),
