+            this.center = new Vector3f(center.x, 0.02f, center.z);
+            this.aim = aim;
+            this.halfArc = halfArc;
+            this.r0 = r0;
+            this.r1 = r1;
+            this.height = height;
+            this.life = Math.max(4, life);
+            int n = Math.max(6, Math.round(28 * halfArc / EggMath.PI));
