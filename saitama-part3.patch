+  auto-place: true         # first start places the missing chests once (recorded in origin-tales.yml)
+  glint-radius: 8
+tales:
+  quills_log:
+    name: "Quill's Harbour Log"
+    district: anker_harbour
+    at: "214 64 -397"
+    place: existing
+    author: "Quill, Harbourmaster"
+    clue: "The harbourmaster keeps a log nobody is supposed to read."
+    note:
+      - "§lDay 4,117.§r\nTide normal. Gulls abnormal. The Halcyon came in eleven minutes late. The captain blamed the wind. The wind declined to comment."
+      - "§lDay 4,118.§r\nOne crate overboard. Contents: hats. The fish are wearing them now. Do not log this.\n\n(Logged.)"
+      - "§lDay 4,119.§r\nA stranger asked where the sea ends. Told them: it doesn't. The island does. They went quiet. Most do."
+    loot:
+      - "PAPER 1 §fTorn Tide Table | §7High water at noon, they say."
+      - "COD 2 §fYesterday's Catch"
+  unsent_letter:
+    name: "A Letter That Never Sailed"
+    district: anker_harbour
+    at: "307 63 -409"
+    place: existing
+    author: "R., deckhand"
+    clue: "On a moored ship, a letter is still waiting for the mail boat."
+    note:
+      - "Dear Mira,\n\nThe ship is fine. The food is not. I've learned eleven knots and forgotten your birthday, which is why this letter is late."
+      - "They say the Halcyon flies over places nobody has walked. I'd like to see one. I'd like more to see you.\n\nTell the chickens hello.\n\n— R."
+    loot:
+      - "PAPER 1 §fSealed Letter | §7To: Mira, Clucksworth. | §8It was never sent."
+      - "STRING 3"
+  confiscated:
+    name: "Confiscated at Customs"
+    district: anker_harbour
+    at: "168 64 -475"
+    place: existing
+    author: "Customs Office, Anker Harbour"
+    clue: "North of the docks, Customs keeps what it took."
+    note:
+      - "§lSEIZED:§r\n1 bottle, label 'NOT RUM'. Is rum.\n3 sacks sugar, declared as 'sand, sweet'.\n1 parrot (escaped)."
+      - "§lSEIZED:§r\n1 map to 'treasure'. The treasure is the Fish Market. Owner fined for wasting everyone's afternoon."
+    loot:
+      - "GLASS_BOTTLE 1 §fBottle, 'NOT RUM' | §7Empty. Of course it's empty."
+      - "SUGAR 3"
+  clucksworth_ledger:
+    name: "The Clucksworth Ledger"
+    district: clucksworth
+    at: "-282 59 124"
+    place: existing
+    author: "Mira Thatch, Clucksworth"
+    clue: "A farm office keeps careful count of something that clucks."
+    note:
+      - "§lEggs this week§r\nDuchess: 7\nPepper: 6\nOld Ruth: 0 (retired, refuses to discuss it)\nThe Baron: 1\n(The Baron is a rooster. Investigating.)"
+      - "Note to self: write back to R. at the harbour. Tell him the chickens say hello.\n\nThey don't. Tell him anyway."
+    loot:
+      - "EGG 2 §fPrize Egg | §7Laid by Duchess, apparently."
+      - "WHEAT_SEEDS 8"
+  smithy_orders:
+    name: "Orders for the Farm Smithy"
+    district: clucksworth
+    at: "-213 61 174"
+    place: existing
+    author: "the Farm Smithy"
+    clue: "Near the barn, the smith's order book lies open."
+    note:
+      - "Hoe, mended.\nHoe, mended again.\nSame hoe. Tell Pepper's owner to stop hitting stones with it.\n\nBell brackets, two. The twin bells need a rest."
+      - "Special order: one anvil, uncracked.\n\nCancelled. Apparently the cracked one is 'tradition'."
+    loot:
+      - "IRON_NUGGET 4 §fBent Nails"
+      - "FLINT 1"
+  misfiled_papers:
+    name: "Misfiled Papers"
+    district: capital
+    at: "107 58 -1"
+    place: existing
+    author: "Miss Ledger"
+    clue: "East of the plaza, a chest of papers that belong somewhere else."
+    note:
+      - "Form 7-B: Request to be excused from Form 7-A.\nStatus: misfiled.\n\nForm 12: Application to name the fountain.\nStatus: denied. It already has a name. The name is 'the fountain'."
+      - "If found, return to Ledger's Court. Do not read.\n\nIf you have read this, please file Form 7-C (Regret)."
+    loot:
+      - "PAPER 2 §fForm 7-C (Regret) | §7Stamped twice. Approved by nobody."
+      - "INK_SAC 1"
+  mead_book:
+    name: "Hettie's Mead Book"
+    district: eastwood
+    at: "290 61 -8"
+    place: existing
+    author: "Hettie Comb"
+    clue: "Among the casks of the Mead House, one barrel holds a recipe."
+    note:
+      - "§lOld Mead§r\nHoney from the north yard. Never the south: the south bees are moody.\nWater from the pond.\nPatience: one winter."
+      - "Do not tell the queen what the honey is for. She knows. She pretends not to. It's a whole thing."
+    loot:
+      - "HONEY_BOTTLE 1 §6Jar of Old Mead | §7Hettie's. Ask nicely."
+      - "HONEYCOMB 2"
+  moss_cache:
+    name: "Notes on Listening"
+    district: whisperwood
+    at: "-406 59 -234"
+    place: chest
+    facing: east
+    author: "Moss"
+    clue: "Near the hermit's hollow, someone keeps notes about silence."
+    note:
+      - "Things I have heard in Whisperwood:\n\nA fox laughing.\nThe river saying three words.\nA tree falling with nobody there. It made a sound. I checked."
+      - "If you are reading this, sit down.\n\nNot for long. Long enough."
+    loot:
+      - "SWEET_BERRIES 6 §fForest Berries"
+      - "PAPER 1 §fA Pressed Leaf | §7From the oldest tree. Probably."
+  shrine_roster:
+    name: "The Brazier Roster"
+    district: whisperwood
+    at: "-285 69 -493"
+    place: chest
+    facing: north
+    author: "Keepers of the Old Shrine"
+    clue: "Below the Old Shrine, a duty roster nobody follows."
+    note:
+      - "Brazier duty:\nMonday: Ilse\nTuesday: Ilse\nWednesday: Ilse\nEveryone else: 'busy'.\n\n(Ilse would like a word.)"
+      - "The fires on the tower have not gone out in two hundred years. Ilse would like it known that she lit most of them."
+    loot:
+      - "CANDLE 2"
+      - "CHARCOAL 3 §fBrazier Charcoal"
+  frog_census:
+    name: "Lily Lake Frog Census"
+    district: whisperwood
+    at: "-420 59 -358"
+    place: chest
+    facing: south
+    author: "Fen Glowmoor, amateur naturalist"
+    clue: "On Lily Lake's shore, somebody tried to count the frogs."
+    note:
+      - "Frogs counted: 41.\nFrogs counted again: 38.\nFrogs that were the same frog: unclear.\nFrogs that looked at me funny: all of them."
+      - "Conclusion: the frogs are fine.\n\nRecommendation: stop counting frogs."
+    loot:
+      - "LILY_PAD 2"
+      - "SLIME_BALL 1 §fFrog Spit | §7Allegedly lucky."
+  star_chart:
+    name: "Stellan's Star Chart"
+    district: skyreach
+    at: "-4 198 -268"
+    place: chest
+    facing: east
+    author: "Stellan Voss"
+    clue: "On the summit, the stargazer keeps his charts out of the wind."
+    note:
+      - "The bright one over the harbour is not a star. It is the Halcyon's lamp.\n\nI have named it anyway: Persistence."
+      - "The aurora comes from the north. The starfall comes from everywhere.\n\nMake your wish quickly. The sky does not wait."
+    loot:
+      - "GLOWSTONE_DUST 3 §eStardust | §7Swept off the summit."
+      - "FEATHER 1"
+  willow_postcard:
+    name: "A Postcard from the Willows"
+    district: skyreach
+    at: "-81 192 -259"
+    place: chest
+    facing: east
+    author: "a tourist, years ago"
+    clue: "Under the Golden Willows, a postcard nobody posted."
+    note:
+      - "Wish you were here! The willows drip actual gold. Don't tell anyone.\n\nThe updraft was terrifying. Would do again."
+      - "P.S. If a nervous man called Pim ever asks: YES. It is worth the climb."
+    loot:
+      - "GOLD_NUGGET 3 §6Willow Gold | §7It drips. Then it doesn't."
+  slag_drafts:
+    name: "The Slag Poet's Drafts"
+    district: ore_ridge
+    at: "79 66 -352"
+    place: chest
+    facing: west
+    author: "the Slag Poet"
+    clue: "On Ore Ridge, a poet threw away his best attempts."
+    note:
+      - "§oO slag, grey slag,\nthou stuff of slag...§r\n\n(crossed out)"
+      - "§oThe ridge is iron,\nthe iron is sleep,\nthe miners dig\nand the mountain weeps.§r\n\nBetter. Still not about slag."
+    loot:
+      - "COAL 3"
+      - "PAPER 1 §fA Poem About Slag | §7It rhymes 'slag' with 'slag'."
+  shift_log:
+    name: "Shift Log, Shabby Mine"
+    district: southwood
+    at: "33 55 180"
+    place: chest
+    facing: north
+    author: "Foreman Dunn"
+    clue: "By the Mine Road, the foreman's log waits for the next shift."
+    note:
+      - "Shift 1: iron.\nShift 2: iron.\nShift 3: tapping in the east tunnel. Nobody down there. Sent Wilks. Wilks came back. Wilks would not say."
+      - "Shift 4: the sponges in the deep gallery drank the flood. Good sponges.\n\nDo not wring the sponges."
+    loot:
+      - "TORCH 6"
+      - "BREAD 2 §fMiner's Lunch | §7Slightly dusty."
+  vex_orders:
+    name: "Standing Orders"
+    district: borderlands
+    at: "160 58 77"
+    place: chest
+    facing: north
+    author: "Sgt. Vex"
+    clue: "At Vex's Gate, the sergeant's orders are kept somewhere obvious."
+    note:
+      - "§lORDER 1:§r Stay behind the line.\n§lORDER 2:§r See Order 1.\n§lORDER 3:§r No, the Ribcage is not 'just bones'."
+      - "If you are reading this, you crossed the line to reach the chest.\n\nWe will be discussing this."
+    loot:
+      - "ARROW 8"
+      - "PAPER 1 §fStanding Order | §7STAY BEHIND THE LINE."
+  warden_notes:
+    name: "Margins of the Rite"
+    district: borderlands
+    at: "250 59 171"
+    place: chest
+    facing: south
+    author: "the Rite Warden"
+    clue: "Near the Rite Circle, the warden writes in the margins."
+    note:
+      - "The stones are not a door. People keep asking.\n\nThe stones are a promise: whatever fell here stays here."
+      - "Light no fires in the circle. Speak no names in the pit.\n\nLeave the gold where it lies. That one is for someone else."
+    loot:
+      - "BONE 3"
+      - "CANDLE 1"
+  pit_camp:
+    name: "The Last Camp in the Pit"
+    district: borderlands
+    at: "218 23 277"
+    place: chest
+    facing: south
+    author: "unsigned"
+    clue: "At the bottom of the sinkhole, somebody once made camp."
+    note:
+      - "We came down for the gold and stayed for the quiet. Up there the wind never stops. Down here it can't reach."
+      - "Lights at night. Not ours. They don't come close. We don't go close.\n\nMutual respect."
+    loot:
+      - "BOWL 1"
+      - "STICK 4"
+      - "PAPER 1 §fA Child's Drawing | §7The sky, drawn as a small circle."
+  molls_wager:
+    name: "Old Moll's Wager"
+    district: seawatch
+    at: "406 56 -399"
+    place: chest
+    facing: north
+    author: "Old Moll"
+    clue: "On Seawatch, across the bay from the lighthouse, a bet is written down."
+    note:
+      - "I bet that gull my spectacles it couldn't reach the top of the lighthouse.\n\nIt could. It did. It kept the spectacles."
+      - "If you see a gull wearing spectacles, it owes me forty years of reading."
+    loot:
+      - "GLASS_PANE 1 §fMoll's Spare Lens | §7Cracked. Still better than the gull's."
+      - "FEATHER 2 §fGull Feather"
+  oak_grievances:
+    name: "Grievances of the Oaks"
+    district: eastwood
+    at: "352 66 -329"
+    place: chest
+    facing: north
+    author: "the Lumberjack, for the oaks"
+    clue: "At the lumber camp, a list of complaints from the trees."
+    note:
+      - "The oaks wish to state:\n1. They were here first.\n2. Axes are rude.\n3. They accept saplings as an apology."
+      - "The lumberjack wishes to state: he plants three for every one he cuts.\n\nThe oaks have not acknowledged this."
+    loot:
+      - "OAK_SAPLING 1 §fAn Apology Sapling"
+      - "STICK 3"
+  betting_slips:
+    name: "Ringside Betting Slips"
+    district: colosseum
+    at: "-332 62 -128"
+    place: chest
+    facing: north
+    author: "Odds Mulligan's runners"
+    clue: "Outside the Colosseum, the bookie's runners stash their slips."
+    note:
+      - "Slip 1: 10 on the challenger. LOST.\nSlip 2: 10 on the champion. LOST.\nSlip 3: 10 on 'nobody'. Under review."
+      - "House rules: the house wins. Exceptions: none.\n\nOdds Mulligan would like you to know he is a fair man."
+    loot:
+      - "PAPER 3 §fLosing Slips"
+      - "GOLD_NUGGET 2 §6Change from a Bet"
+  fens_diary:
+    name: "Fen's Glowcap Diary"
+    district: glowcap_crags
+    at: "-407 64 243"
+    place: chest
+    facing: east
+    author: "Fen Glowmoor"
+    clue: "Near the Twin Glowcaps, the tender's diary is tucked away."
+    note:
+      - "Day 1: the Twin Glowcaps are not twins. One is older.\n\nDo not tell the younger one."
+      - "Day 40: tried to grow a cutting. It glowed for a week and then sulked.\n\nI understand completely."
+    loot:
+      - "GLOW_BERRIES 3"
+      - "BROWN_MUSHROOM 2"
+  pickers_map:
+    name: "A Flower Picker's Map"
+    district: bloomfield
+    at: "-41 55 -445"
+    place: chest
+    facing: north
+    author: "a picker from Bloomfield"
+    clue: "By the Bloom Road, a picker hid a map of every flower."
+    note:
+      - "X marks a bloom. There are many X's. That's the whole map. It's mostly X's.\n\nI may have overdone it."
+      - "Best blossoms: north of the road, under the big tree.\n\nSecond best: everywhere else."
+    loot:
+      - "PINK_PETALS 4"
+      - "PAPER 1 §fPicker's Map | §7Every X is a bloom. There are a lot of X's."
