+            int visible = line.toString().replaceAll("§.", "").length();
+            if (visible > 0 && visible + 1 + word.replaceAll("§.", "").length() > width) {
+                out.add(color + line);
+                line.setLength(0);
+            }
+            if (!line.isEmpty()) {
+                line.append(' ');
+            }
+            line.append(word);
+        }
+        if (!line.isEmpty()) {
+            out.add(color + line);
+        }
+        return out;
+    }
