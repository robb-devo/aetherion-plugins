+  clucks_windmill: {prop: ae_edge_windmill, at: "-244 65 256", rotate: 180, group: clucksworth, name: "South Windmill", note: "Clucksworth's south fields."}
+  bay_pots: {prop: ae_prop_lobster_pots, at: "320 63 -568", rotate: 180, group: harbour_north, name: "Lobster Pots", note: "North shore of the bay."}
