+  anchor_camp: {prop: ae_prop_forest_campsite, at: "-475 56 -92", rotate: 270, group: fallen_anchor, name: "Anchor Camp", note: "The Anchorkin's tent and fire under the anchor. Hesper's seat is by the fire."}
