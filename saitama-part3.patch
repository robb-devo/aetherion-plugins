@@ -0,0 +1,1349 @@
+# =====================================================================================================
+#  Origin Isle - exploration layer (curiosities, storytelling chests, prop spots, ambient life).
+#  Same rules as origin.yml: missing keys are merged from the jar on every start, your edits stay.
+#  Every spot below was checked against the original map: standable, reachable on foot from the plaza
+#  (or from an updraft top; "swim" lilies are a short swim from the shore), and line of sight for look/touch.
+# =====================================================================================================
+
+# Curiosities: small hidden finds. kind: step (stand there) | look (hold your gaze on it) | touch (right-click it)
+# | listen (sneak and keep still). at = where you stand (for look/touch: a spot it can be seen from).
+# target = the block for look/touch. when: any | day | night | dusk | dawn | rain. requires: prop:<spot> = only
+# once that prop spot is pasted. Rewards: rewards.curiosity per find, rewards.curio-district per district swept.
+curiosity-settings:
+  glint-radius: 9          # undiscovered finds glint faintly within this distance (particles on)
+  look-hold-checks: 3      # 8-tick checks your gaze must stay on a look-curiosity (~1.2 s)
+  listen-checks: 7         # 8-tick checks of sneaking still for a listen-curiosity (~2.8 s)
+  milestones:
+    curious:       {title: "§dCurious", count: 10, reward: curious, fallback: 300}
+    keen_eyed:     {title: "§dKeen-Eyed", count: 25, reward: keen_eyed, fallback: 800}
+    lorekeeper:    {title: "§5Lorekeeper", count: 45, reward: lorekeeper, fallback: 1500}
+    small_wonders: {title: "§d§lKeeper of Small Wonders", count: 0, reward: small_wonders, fallback: 4000}  # 0 = every curiosity
+curiosities:
+  fountain_turtles:
+    name: "Turtles in Town"
+    district: capital
+    kind: look
+    at: "-42.5 59 -79.5"
+    target: "-45 59 -82"
+    range: 10
+    radius: 0.9
+    icon: TURTLE_EGG
+    clue: "Someone is keeping something warm by the fountain."
+    note: "Turtle eggs in a planter, nowhere near the sea. Nobody admits to putting them there. Everybody checks on them."
+  windmill_garden:
+    name: "The Windowsill Garden"
+    district: capital
+    kind: step
+    at: "89.5 59 -15.5"
+    radius: 3
+    icon: FLOWER_POT
+    clue: "Under the great mill, somebody grows a desert, a swamp and a beach in pots."
+    note: "A cactus, a dripleaf and a clutch of eggs in one tiny garden. The miller calls it the world, small enough to water."
+  snow_never_melts:
+    name: "The Snow That Stays"
+    district: capital
+    kind: step
+    at: "-99.5 63 -4.5"
+    radius: 1.6
+    icon: SNOWBALL
+    clue: "One handful of winter refuses to leave the Capital."
+    note: "A single layer of snow in a sunny lane. It has not melted since the city was built. The scholars measure it every spring."
+  capital_roofs:
+    name: "Over the Rooftops"
+    district: capital
+    kind: step
+    at: "-86.5 72 -137.5"
+    radius: 2.5
+    icon: DARK_OAK_TRAPDOOR
+    clue: "The Capital looks different from where the cats walk."
+    note: "From up here the fountain is a coin and the Grand Stair a ribbon. The tiles are warm. A cat watches you, unimpressed."
+  collectors_shelf:
+    name: "The Collector's Shelf"
+    district: capital
+    kind: look
+    at: "63.5 64 110.5"
+    target: "61 67 112"
+    range: 8
+    radius: 0.9
+    icon: SKELETON_SKULL
+    clue: "Behind the Market Hall, somebody keeps a shelf of things that grin."
+    note: "Two skulls and three locked ender chests. The label says 'not for sale'. The skulls seem to agree."
+  quiet_enchanter:
+    name: "The Quiet Enchanter"
+    district: capital
+    kind: touch
+    at: "-59.5 59 -79.5"
+    target: "-59 59 -80"
