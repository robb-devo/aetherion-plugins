+# Prop paste layer (DEV): the Hub prop schematics at pre-checked spots. /origin dev props <list|paste|undo|tp|show>.
+# at = the FAWE paste origin (first-pass props anchor on the feet block, second-pass ones on the ground block;
+# both were fitted that way). Checked: nothing above the ground layer collides, >= 80% of the ground layer sits
+# on solid ground, no roads, walkable approach, and no NPC seat, landmark, curiosity or tale inside the box.
+prop-settings:
+  # Hesper Kael stays a manual story placement: /questnpc story -> Hesper's anchor -> right-click this spot.
+  hesper-seat: "-475.5 56 -93.5 -115"
