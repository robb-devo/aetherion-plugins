@@ -0,0 +1,373 @@
+# =====================================================================================================
+#  Origin Isle — the main island (OriginBuilds "Skyblock RPG Spawn", pasted 1:1 into `world`).
+#  Owned by AetherionHub (de.aetherion.hub.origin). Every coordinate below was measured from the
+#  original world file (region data, 985 x 981 blocks, x -526..458, z -616..364, ground ~57-64).
+#  Missing keys are merged into plugins/AetherionHub/origin.yml on start; your edits are never overwritten.
+# =====================================================================================================
+
+enabled: true
+world: world
+
+# XZ box the Origin systems run in (the island plus a small margin).
+footprint:
+  min-x: -540
+  max-x: 470
+  min-z: -630
+  max-z: 380
+
+# Players who haven't unlocked this hub camp yet (the Harbour Hour tutorial) get quiet discovery:
+# action bar + chat only, no titles, no tour offer. Set to "" to disable.
+quiet-until-spawn: capital
+
+# Fall off the island? The wind puts you back on your last safe footing (only if you stood on the
+# island in the last 30 s, never for someone who was already down there). The underside is ~y 13-39,
+# with hanging rock roots down to about -50; the void kills at -128.
+rescue:
+  enabled: true
+  floor-y: -60
+
+rewards:
+  district: 150
+  landmark: 60
+  waystone: 100
+  bell: 60
+  vista: 120
+  skyway: 80
+  updraft: 80
+  wayfarer: 2000        # every district
+  cartographer: 3000    # every landmark
+  glowcap-circle: 1500  # every waystone attuned
+  bellwright: 1500      # all seven bells
+  stargazer: 750        # every vista
+  skyrider: 1000        # every skyway, glide and updraft
+  tour: 1000            # once per player
+  wish: 25              # once per Starfall
+  fountain-favour: 250  # the rare wishing-fountain payback
+
