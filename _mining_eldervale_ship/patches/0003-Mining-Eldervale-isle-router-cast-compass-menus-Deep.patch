+    /** First {@code want} numbers of "a b c" / "a,b,c", or {@code null}. */
+    public static double[] numbers(String raw, int want) {
+        if (raw == null) {
+            return null;
+        }
+        String[] parts = raw.trim().split("[\\s,]+");
+        if (parts.length < want) {
+            return null;
+        }
+        double[] out = new double[want];
+        try {
+            for (int i = 0; i < want; i++) {
+                out[i] = Double.parseDouble(parts[i]);
+            }
+        } catch (NumberFormatException ignored) {
+            return null;
+        }
+        return out;
+    }
+
+    /** "+12" / "12.5" without a trailing ".0". */
+    public static String num(double value) {
+        return value == Math.floor(value) ? String.valueOf((long) value) : String.format(Locale.US, "%.1f", value);
+    }
+
     public static String plural(long amount, String noun) {
         return amount + " " + noun + (amount == 1 ? "" : "s");
     }
