---
 .../src/main/java/de/aetherion/mining/isle/MineCritters.java    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AetherionMining/src/main/java/de/aetherion/mining/isle/MineCritters.java b/AetherionMining/src/main/java/de/aetherion/mining/isle/MineCritters.java
index 1fa220a3..ed4dd249 100644
--- a/AetherionMining/src/main/java/de/aetherion/mining/isle/MineCritters.java
+++ b/AetherionMining/src/main/java/de/aetherion/mining/isle/MineCritters.java
@@ -680,7 +680,7 @@ public final class MineCritters implements Listener {
     }
 
     private void fizzle(Critter critter) {
-        if (critter.at != null && critter.at.getWorld() != null) {
+        if (critter.body != null && critter.body.isValid() && critter.at != null && critter.at.getWorld() != null) {
             critter.at.getWorld().spawnParticle(Particle.SMOKE, critter.at.clone().add(0, 0.4, 0), 8, 0.2, 0.2, 0.2, 0.02);
         }
         remove(critter);
