+        inventory.setItem(4, button(Material.DIAMOND_PICKAXE, "§6§lMining Island", "page:" + HUB, status.toArray(String[]::new)));
+
+        inventory.setItem(10, button(Material.ENDER_PEARL, "§bTeleport: Landing", PREFIX + "tp:Landing",
