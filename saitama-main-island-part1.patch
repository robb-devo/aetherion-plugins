+            }
+        }
+
+        void despawn() {
+            for (BlockDisplay d : parts) {
+                remove(d);
+            }
+            parts.clear();
+            remove(rope);
+            remove(crate);
+            rope = null;
+            crate = null;
+            remove(root);
+            root = null;
+        }
+    }
