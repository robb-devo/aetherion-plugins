 # NPC-to-NPC banter — index-aligned with CastBook.banter(), same speakers per beat.
 # Played to everyone in range when most of them read German. Never use {player} here.
+  # Origin island cast (SAITAMA pass)
+  harbourmaster:
+    greet_new: ["Name und Fracht, {player}. Spaß. Willkommen im Ankerhafen."]
+    greet: ["{player}. Heute ist nichts gesunken. Noch nicht.", "Wieder auf meinem Wasser, {player}? Pass auf die Taue auf."]
+    idle: ["Die Halcyon hat ihre eigenen Zeiten. Ich hab das Buch.", "*leckt am Bleistift* Vier Kisten rein, drei raus. Wo ist die vierte?", "Was schwimmt, gehört mir. Was fliegt, auch. Der Papierkram wächst.", "Pass auf den Kran auf. Haul schwenkt, als wär er zu spät dran."]
+    farewell: ["Guten Wind. Oder wenigstens trockenen."]
+    topics:
+      - label: "Was ist die Halcyon?"
+        lines: ["Versorgungs-Himmelsschiff. Kommt alle paar Glocken über den Nordrand.", "Lässt eine Kiste am Seil runter, ein Kahn fängt sie. Meistens."]
+      - label: "Wo fang ich an?"
+        lines: ["§eEgon§f auf dem Pier rüstet die Grünschnäbel aus. Dann folg dem gelben Pfeil.", "Danach? Dieser Hafen hat mehr Geschichten als Seepocken."]
+  crane_hand:
+    greet_new: ["Kopf einziehen, {player}. Der Kran tut's nicht."]
+    greet: ["{player}! Weg vom Haken."]
+    idle: ["Hoch damit!", "*pfeift dem Kran zu*", "Kiste, Kahn, Kiste, Kahn. Poesie.", "Eines Tages heb ich die ganze Halcyon. Eines Tages."]
+    farewell: ["Schwenkbereich frei!"]
+    topics:
+      - label: "Wie funktioniert der Kran?"
+        lines: ["Seil, Haken, ich brülle. Hauptsächlich das Brüllen."]
+      - label: "Was Seltsames gesehen?"
+        lines: ["Ein Fass kam leer hoch, aber schwerer als voll. Ich hab's zurückgelegt.", "Manche Dinge wollen im Wasser bleiben."]
+  lighthouse_keeper:
+    greet_new: ["Ahoi, {player}. Du hast Seebeine, oder kriegst sie noch."]
+    greet: ["{player}. Das Licht brennt. Bitte sehr."]
+    idle: ["*blinzelt* Ohne Brille seh ich gar nichts. Verdammte Möwe.", "Jedes Schiff, das heimkommt, zähl ich. Jedes einzelne.", "Nachts redet das Meer. Ich rede zurück.", "Vierzig Jahre auf diesem Pier. Die Möwen respektieren mich immer noch nicht."]
+    farewell: ["Halt das Licht zu deiner Linken."]
+    topics:
+      - label: "Ein Leuchtturm, auf einer Himmelsinsel?"
+        lines: ["Schiffe fliegen im Nebel tiefer, als du denkst.", "Und die Fischer brauchen was zum Fluchen."]
+      - label: "Die Möwe?"
+        lines: ["Groß. Grau. Diebin. Hat mir die Brille von der Nase geklaut.", "Sie hockt hoch. Immer hoch. Angeberin."]
+  shanty_busker:
+    greet_new: ["Ein neues Gesicht! Jedes neue Gesicht kriegt eine Strophe, {player}."]
+    greet: ["{player}! Klopf mit dem Fuß. Kostet nichts."]
+    idle: ["♪ Oh, die Halcyon zieht durch das Morgenblau … ♪", "Münzen im Hut sind Applaus, den man ausgeben kann.", "Ich kenn vierzig Shantys. Neununddreißig handeln von Fisch.", "♪ Hol ein, hol ein, der Kran hat die Kist' … ♪"]
+    farewell: ["Summ's unterwegs!"]
+    topics:
+      - label: "Spiel mir was."
+        lines: ["♪ Drei Glocken am Kai und die Flut kommt herein, die Möwen stehl'n dein Brot und der Dorsch stiehlt dein Grins'n … ♪", "Das ist neu. Braucht noch einen Refrain."]
+      - label: "Warum spielst du hier?"
+        lines: ["Beste Akustik der Insel. Wasser, Holz und Leute, die zu höflich sind, um zu gehen."]
+  beekeeper:
+    greet_new: ["Langsame Bewegungen, {player}. Die Mädels schauen zu."]
+    greet: ["{player}! Riechst du das? Das ist reifender Met."]
+    idle: ["*summt mit den Stöcken*", "Bienen stechen keine guten Leute. Meistens.", "Das Alte Methaus stand hier schon vor den Straßen.", "Drei Stöcke dieses Jahr. Vier, wenn der Schwarm heimkommt."]
+    farewell: ["Bleib summig! … Sag ich jedes Mal."]
+    topics:
+      - label: "Met?"
+        lines: ["Honig, Wasser, Geduld. Und ein Geheimnis, das ich mit in den Stock nehme."]
+      - label: "Dieses Haus?"
+        lines: ["Älter als das Pflaster der Hauptstadt. Um die Stöcke herum gebaut, nicht andersrum."]
+  painter:
+    greet_new: ["Nicht bewegen — das Licht auf dir ist perfekt, {player}. … Jetzt ist es weg."]
+    greet: ["{player}! Willst du gemalt werden?"]
+    idle: ["*tupft auf die Leinwand*", "Grün. Mehr Grün. Nein — das andere Grün.", "Die Windmühle hält nicht still. Ist die Schuld vom Wind.", "Jede Aussicht auf dieser Insel ist ein Bild, das keiner fertig gemalt hat."]
+    farewell: ["Find mir eine Aussicht!"]
+    topics:
+      - label: "Was malst du?"
+        lines: ["Die Mühle. Schon wieder. Meine elfte Mühle.", "Die anderen zehn waren Übung."]
+      - label: "Beste Aussicht?"
+        lines: ["Frag Stellan oben am Gipfel. Der sagt: die Sterne.", "Ich sag: die, zu der du gelaufen bist."]
+  hermit:
+    greet_new: ["Psst. … Oh. Hallo, {player}."]
+    greet: ["Du bist wiedergekommen. Die Bäume meinten, du würdest."]
+    idle: ["…", "*atmet sehr langsam*", "Die Rinde redet. Meistens Frechheiten.", "Ich bin für eine Minute hier rausgekommen. Das war vor neun Jahren."]
+    farewell: ["Geh leise."]
+    topics:
+      - label: "Warum lebst du hier draußen?"
+        lines: ["Die Hauptstadt ist laut. Der Hafen ist lauter. Hier draußen flüstert sogar der Wind."]
+      - label: "Was sagen die Bäume?"
+        lines: ["Dass die Glocken früher anders klangen.", "Ich frag nicht, was das heißt. Solltest du auch nicht. Noch nicht."]
+  bookie:
+    greet_new: ["Frische Beine! Ich geb dir vier zu eins, {player}."]
+    greet: ["{player}! Fühlst du dich heute schnell?"]
+    idle: ["Quote auf die nächste Halcyon? Sechs Minuten. Immer sechs.", "Vince macht Glücksspiele. Ich mach Beinspiele.", "*zählt die Münzen zweimal*", "Wette nie gegen einen Sprinter in guten Stiefeln."]
+    farewell: ["Lauf nicht weg. Außer ich hab dich dafür bezahlt."]
+    topics:
+      - label: "Was ist die Wette?"
+        lines: ["Berühr das Bergtor und sei in drei Minuten zurück. Leichtes Geld.", "Himmelswege zählen. Teleports nicht. Da gibt's einen Unterschied, rechtlich."]
+      - label: "Und Vince?"
+        lines: ["Netter Mann. Schreckliche Quoten. Meine sind schlechter, aber ich lächle mehr."]
+  mushroom_forager:
+    greet_new: ["Pass auf, wo du hintrittst, {player}. Hier wächst was."]
+    greet: ["{player}! Riechst du die Luft? Sporen. Herrlich."]
+    idle: ["*schnüffelt an einem Pilz* Essbar. Wahrscheinlich.", "Die großen leuchten nachts. Nicht ablecken.", "Die Pilze im Ostwald sind älter als die Bäume.", "Iss nie einen Pilz, der deinen Namen kennt."]
+    farewell: ["Bis spora!"]
+    topics:
+      - label: "Die leuchten?"
+        lines: ["Drei der Riesen tun's, nach Einbruch der Dunkelheit. Blassblau an den Lamellen.", "Find sie, dann sag ich dir, welche essbar sind. Keiner."]
+      - label: "Warum so groß?"
+        lines: ["Aether im Boden. Dasselbe Zeug, das die Insel oben hält.", "Zu viel davon, und ein Pilz kriegt Ideen."]
+  lost_tourist:
+    greet_new: ["Oh! Ein Einheimischer! Hallo, {player}! Ist das der Gipfel?"]
+    greet: ["{player}! Ich hab mich heute vier Blöcke bewegt. Fortschritt!"]
+    idle: ["*dreht die Karte auf den Kopf*", "Im Prospekt stand 'ein kurzer Spaziergang zum Gipfel'.", "Ist das der große Berg, oder ist der große dahinter?", "Ich hab diesen Brunnen neunzigmal gezeichnet. Sehr schöner Brunnen."]
+    farewell: ["Wenn du den Gipfel siehst, grüß ihn von mir!"]
+    topics:
+      - label: "Wo kommst du her?"
+        lines: ["Von einer anderen Insel. Einer flachen. Sehr flach. Deshalb bin ich hier."]
+      - label: "Wie komm ich auf den Skyreach?"
+        lines: ["Im Prospekt steht 'das Bergtor, dann der Wind'.", "Ich dachte, das sei Poesie. Ist das keine Poesie?"]
