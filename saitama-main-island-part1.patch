+                }
+            }
+            if (crateHanded && ropeLen > 0.0d && held % 4 == 0) {
+                ropeLen = Math.max(0.0d, ropeLen - 1.4d);
+                drawRope(4);
+            }
+            if (clock % 100 == 0) {
+                particles(at.clone().add(0, 1.0, -6.6), Particle.CAMPFIRE_COSY_SMOKE, 2, 0.2d, 0.01d, 90.0d);
