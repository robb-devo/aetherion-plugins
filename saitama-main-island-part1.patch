+        }
+
+        private boolean skiffWaiting() {
+            for (Skiff skiff : skiffs) {
+                if (skiff.waitingForCrate) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private void handCrate(World world) {
+            crateHanded = true;
+            Skiff taker = null;
+            for (Skiff skiff : skiffs) {
+                if (skiff.waitingForCrate) {
+                    taker = skiff;
+                    break;
+                }
+            }
+            if (crate != null) {
