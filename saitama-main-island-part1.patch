+            }
+            if (crateDown && !crateHanded && ropeLen < ropeTarget && held % 4 == 0) {
+                ropeLen = Math.min(ropeTarget, ropeLen + 0.9d);
+                drawRope(4);
+                if (held % 12 == 0) {
