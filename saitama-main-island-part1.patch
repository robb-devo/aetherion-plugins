+  isle_long_shot_declined: ["Klug. Langweilig, aber klug."]
+  isle_long_shot_active_chip: "Läuft noch!"
+  isle_long_shot_done_chip: "Zurück! Zahl!"
+  isle_long_shot_done: ["Unter drei! Ich würd deine Stiefel auf Federn prüfen, wenn ich nicht zahlen müsste.", "Doppelt, wie versprochen. Sag's nicht Vince."]
+  isle_long_shot_fail: ["Zeit! Ich hab schnellere Schnecken gesehen. Komm wieder, wenn du dich gedehnt hast."]
+  isle_long_shot_gate_found: "Du klatschst aufs Bergtor. Jetzt zurück zu Odds — lauf!"
+  isle_long_shot_gate_hint: "Das Bergtor — im Norden, hinter dem Brunnenplatz und die Große Treppe hoch."
