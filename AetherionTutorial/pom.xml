<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.aetherion</groupId>
    <artifactId>aetherion-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>AetherionTutorial</artifactId>
  <name>AetherionTutorial</name>
  <description>Morningbell: the tutorial isle. Teaches every core system once, in order, then sails the new player to Anker Harbour.</description>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.aetherion</groupId>
      <artifactId>AetherionCore</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.aetherion</groupId>
      <artifactId>AetherionItems</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.aetherion</groupId>
      <artifactId>AetherionQuests</artifactId>
      <version>${aetherion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.aetherion</groupId>
      <artifactId>BossEngine</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>AetherionTutorial-${project.version}</finalName>
  </build>
</project>
